extends layout

block content
  main
    //- Left Sidebar Image Card
    aside#photos
      img(src="/images/chili.jpg" alt="White Chicken Chili" width="180")
    
    //- Render the cursive <blogtitle> component
    h2: blogtitle

    //- Comments section
    section#blogposts
      ul
        li#posts(v-for="post in posts")
          span.profile
            img(v-bind:src="post.profilepic" v-on:click="authorinfo(posts, post)")
          span.author {{ post.name }}
          |  — 
          span.date {{ post.date }}
          span.reply {{ post.reply }}
          p {{ post.message }}
        
        //- Bio Modal Popup
        div#info_box(v-for="post in posts" v-if="post.thisBox")
          p.closeBtn.closeBtnP(v-on:click="post.thisBox = false") &#10006;
          div#info_title {{ post.name }}
          div#info_foodie
            span Foodie Level: 
            | {{ post.foodielevel }}
          div#info_bio
            span Bio:
            br
            | {{ post.bio }}
          button.closeBtn.closeBtnB(v-on:click="post.thisBox = false") Close
          p#close_info